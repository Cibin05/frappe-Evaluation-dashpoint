 "font_size": 14,
 "html": "\r\n<body>\r\n    {{letter_head}}\r\n    \r\n    <table class=\"table table-bordered\">\r\n        <tr>\r\n            <td colspan=\"2\" style=\"text-align:center\">Customer Details</td>\r\n        </tr>\r\n        <tr>\r\n            <td>Customer Name:</td>\r\n            <td>{{doc.customer_name}}</td>\r\n        </tr>\r\n\r\n        <tr>\r\n            <td>Customer Phone:</td>\r\n            <td>{{doc.customer_phone}}</td>\r\n        </tr>\r\n        <tr>\r\n            <td>Customer Email:</td>\r\n            <td>{{doc.customer_email}}</td>\r\n        </tr>\r\n        <tr>\r\n            <td>Customer Address:</td>\r\n            <td>{{doc.pickup_address}}</td>\r\n        </tr>\r\n        <tr>\r\n            <td colspan=\"2\" style=\"text-align:center\">Packaging Details</td>\r\n        </tr>\r\n        <tr>\r\n            <td colspan=\"2\">\r\n                <table class=\"table\">\r\n                    <tr>\r\n                        <th>Material Name</th>\r\n                        <th>Unit Price</th>\r\n                        <th>Quantity</th>\r\n                        <th>Total Price</th>\r\n                    </tr>\r\n\r\n                    {% for row in doc.packaging_used %}\r\n                    <tr>\r\n                        <td>{{row.material_name}}</td>\r\n                        <td>{{row.unit_price}}</td>\r\n                        <td>{{row.quantity}}</td>\r\n                        <td>{{row.total_price}}</td>\r\n                    </tr>\r\n                    {% endfor %}\r\n                </table>\r\n            </td>\r\n        </tr>\r\n        {% if doc.payment_status == \"COD Pending\" %}\r\n        <tr>\r\n            <td colspan=\"2\" style=\"text-align:center; font-weight:bold;\">\r\n                COD \u2014 COLLECT \u20b9{{doc.final_amount}} ON DELIVERY\r\n            </td>\r\n        </tr>\r\n        {% endif %}\r\n        <tr>\r\n            <td style=\"font-weight:bold\">Final Amount</td>\r\n            <td style=\"font-weight:bold\">\r\n                {{ frappe.format(doc.final_amount,\"Currency\" ) }}\r\n            </td>\r\n        </tr>\r\n    </table>\r\n</body>\r\n{{footer}}\r\n",
